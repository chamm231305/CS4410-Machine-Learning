        "import matplotlib.pyplot as plt\n",
        "from sklearn.datasets import load_iris\n",
        "from sklearn.model_selection import GridSearchCV, cross_val_score\n",
        "from sklearn.neighbors import KNeighborsClassifier\n",
        "import os\n",
        "\n",
        "# Create a directory to save plots if it doesn't exist\n",
        "output_dir = 'images'\n",
        "os.makedirs(output_dir, exist_ok=True)\n",
        "\n",
        "# 1. Load the Iris dataset\n",
        "iris = load_iris()\n",
        "X = iris.data\n",
        "y = iris.target\n",
        "\n",
        "# 2. Hyperparameter Tuning using cross_val_score with cv=10\n",
        "k_range = range(1, 31)\n",
        "k_scores = []\n",
        "\n",
        "for k in k_range:\n",
        "    knn = KNeighborsClassifier(n_neighbors=k)\n",
        "    scores = cross_val_score(knn, X, y, cv=10, scoring=\"accuracy\")\n",
        "    k_scores.append(scores.mean())\n",
        "\n",
        "# Print mean accuracy for each k to identify the optimal k value\n",
        "for k, score in zip(k_range, k_scores):\n",
        "    print(f\"k = {k:2d} | Cross-Validated Accuracy: {score:.4f}\")\n",
        "\n",
        "optimal_k = k_range[k_scores.index(max(k_scores))]\n",
        "print(f\"\\nOptimal k determined by loop: k = {optimal_k}\")\n",
        "\n",
        "# 3. Plotting 'Value of K for KNN' vs. 'Cross-Validated Accuracy'\n",
        "\n",
        "# Graph 1: Standard line plot showing the overall trend\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(k_range, k_scores, color=\"blue\", linestyle=\"dashed\", marker=\"o\")\n",
        "plt.title(\"Value of K for KNN vs. Cross-Validated Accuracy\")\n",
        "plt.xlabel(\"Value of K for KNN\")\n",
        "plt.ylabel(\"Cross-Validated Accuracy\")\n",
        "plt.xticks(range(1, 31, 2))\n",
        "plt.grid(True)\n",
        "plt.savefig(os.path.join(output_dir, 'knn_accuracy_trend.png')) # Save the plot\n",
        "plt.show()\n",
        "\n",
        "# Graph 2: Detailed plot highlighting peak values/optimal K\n",
        "plt.figure(figsize=(10, 5))\n",
        "plt.plot(k_range, k_scores, marker=\"o\", color=\"green\")\n",
        "plt.axvline(\n",
        "    x=optimal_k,\n",
        "    color=\"red\",\n",
        "    linestyle=\"--\",\n",
        "    label=f\"Optimal K = {optimal_k}\",\n",
        ")\n",
        "plt.title(\"Hyperparameter Tuning: Optimal K Identification\")\n",
        "plt.xlabel(\"Value of K for KNN\")\n",
        "plt.ylabel(\"Cross-Validated Accuracy\")\n",
        "plt.legend()\n",
        "plt.grid(True)\n",
        "plt.savefig(os.path.join(output_dir, 'knn_optimal_k_identification.png')) # Save the plot\n",
        "plt.show()\n",
        "\n",
        "# 4. Confirmation using GridSearchCV\n",
        "param_grid = dict(n_neighbors=list(range(1, 31)))\n",
        "grid = GridSearchCV(\n",
        "    KNeighborsClassifier(), param_grid, cv=10, scoring=\"accuracy\"\n",
        ")\n",
        "grid.fit(X, y)\n",
        "\n",
        "print(\"--- GridSearchCV Confirmation ---\")\n",
        "print(f\"Best Parameters: {grid.best_params_}\")\n",
        "print(f\"Best Cross-Validated Accuracy: {grid.best_score_:.4f}\")"
      ]
    },
