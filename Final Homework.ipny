      "source": [
        "import pandas as pd\n",
        "\n",
        "summary_data = {\n",
        "    \"Experiment\": [\n",
        "        \"16.1 MNIST Baseline\",\n",
        "        \"16.1 Fashion-MNIST\",\n",
        "        \"16.4 Removed Dense Layer\",\n",
        "        \"16.4 Added Dense(4096)\"\n",
        "    ],\n",
        "    \"Expected Accuracy Range\": [\n",
        "        \"~99.0% - 99.3%\",\n",
        "        \"~91.0% - 92.5%\",\n",
        "        \"~98.5% - 99.0%\",\n",
        "        \"~98.5% - 99.2% (Risk of Overfitting)\"\n",
        "    ],\n",
        "    \"Impact on Speed / Time\": [\n",
        "        \"Fast (Baseline)\",\n",
        "        \"Same as MNIST (~same params)\",\n",
        "        \"Slightly Faster (Fewer params)\",\n",
        "        \"Significantly Slower (Millions of params)\"\n",
        "    ]\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(summary_data)\n",
        "df"
