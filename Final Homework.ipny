      ],
      "source": [
        "def evaluate_dataset(dataset_name, dataset_module):\n",
        "    print(f\"\\n==========================================\")\n",
        "    print(f\"   Running Exercise 16.1: {dataset_name}\")\n",
        "    print(f\"==========================================\")\n",
        "\n",
        "    # Load data\n",
        "    (train_images, train_labels), (test_images, test_labels) = dataset_module.load_data()\n",
        "\n",
        "    # Reshape and normalize data (28x28x1 grayscale)\n",
        "    train_images = train_images.reshape((60000, 28, 28, 1)).astype('float32') / 255\n",
        "    test_images = test_images.reshape((10000, 28, 28, 1)).astype('float32') / 255\n",
        "\n",
        "    # One-hot encode targets\n",
        "    train_labels = to_categorical(train_labels)\n",
        "    test_labels = to_categorical(test_labels)\n",
        "\n",
        "    # Standard Chapter 16 Convnet Model\n",
        "    model = models.Sequential([\n",
        "        layers.Conv2D(32, (3, 3), activation='relu', input_shape=(28, 28, 1)),\n",
        "        layers.MaxPooling2D((2, 2)),\n",
        "        layers.Conv2D(64, (3, 3), activation='relu'),\n",
        "        layers.MaxPooling2D((2, 2)),\n",
        "        layers.Flatten(),\n",
        "        layers.Dense(64, activation='relu'),\n",
        "        layers.Dense(10, activation='softmax')\n",
        "    ])\n",
        "\n",
        "    model.compile(optimizer='adam',\n",
        "                  loss='categorical_crossentropy',\n",
        "                  metrics=['accuracy'])\n",
        "\n",
        "    # Train and measure timing\n",
        "    start_time = time.time()\n",
        "    history = model.fit(train_images, train_labels, epochs=5, batch_size=64, validation_split=0.1, verbose=1)\n",
        "    end_time = time.time()\n",
        "\n",
        "    elapsed_time = end_time - start_time\n",
        "    test_loss, test_acc = model.evaluate(test_images, test_labels, verbose=0)\n",
        "\n",
        "    print(f\"\\n--- {dataset_name} Results ---\")\n",
        "    print(f\"Total Training Time: {elapsed_time:.2f} seconds\")\n",
        "    print(f\"Test Accuracy: {test_acc * 100:.2f}%\")\n",
        "\n",
        "    return elapsed_time, test_acc\n",
        "\n",
        "# Run experiments\n",
        "mnist_time, mnist_acc = evaluate_dataset(\"MNIST\", mnist)\n",
        "fashion_time, fashion_acc = evaluate_dataset(\"Fashion-MNIST\", fashion_mnist)"
      ]
    },
